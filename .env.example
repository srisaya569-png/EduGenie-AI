# Copy this file to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
APP_NAME=EduGenie
MAX_INPUT_CHARS=20000
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.4

# Set true to test the interface without an API key (responses are sample/demo content).
DEMO_MODE=false
